/target
/dist

# Key material and rendered secrets must never be committed.
*.key
sealref.key
*.sealref-tmp

# Client certificates and private keys for mutual TLS.
*.pem
*.p12
*.pfx

# Local environment files. Commit the sealed example instead.
.env
.env.*
!.env.example

# Claude Code per-user state. Shared project files under .claude/, such as skills, are committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock
