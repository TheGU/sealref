#!/usr/bin/env bash
# Refuses a push until scripts/ci-local.sh passes on every branch commit being pushed.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail

root=$(git rev-parse --show-toplevel)
tested=" "
status=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
    case "$local_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    if [ -z "${local_sha//0/}" ] || [[ "$tested" == *" $local_sha "* ]]; then
        continue
    fi
    tested="$tested$local_sha "
    echo "pre-push: running CI locally for ${local_ref#refs/heads/}"
    if ! "$root/scripts/ci-local.sh" "$local_sha" </dev/null; then
        echo "pre-push: CI failed locally for ${local_ref#refs/heads/}; the push is refused." >&2
        status=1
    fi
done

exit "$status"
